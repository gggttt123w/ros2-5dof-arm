--- a/drivers/net/can/rockchip/rockchip_canfd.c
+++ b/drivers/net/can/rockchip/rockchip_canfd.c
@@ -745,10 +745,11 @@
 {
 	struct rockchip_canfd *rcan = netdev_priv(ndev);
 	struct net_device_stats *stats = &ndev->stats;
-	struct can_frame *cf;
+	struct can_frame *cf = NULL;
 	struct sk_buff *skb;
 	unsigned int rxerr, txerr;
 	u32 sta_reg;
+	bool classified = false;
 
 	skb = alloc_can_err_skb(ndev, &cf);
 
@@ -764,7 +765,8 @@
 	if (isr & BUS_OFF_INT) {
 		rcan->can.state = CAN_STATE_BUS_OFF;
 		rcan->can.can_stats.bus_off++;
-		cf->can_id |= CAN_ERR_BUSOFF;
+		if (likely(skb))
+			cf->can_id |= CAN_ERR_BUSOFF;
 	} else if (isr & ERR_WARN_INT) {
 		rcan->can.can_stats.error_warning++;
 		rcan->can.state = CAN_STATE_ERROR_WARNING;
@@ -781,12 +783,28 @@
 		rcan->can.can_stats.error_passive++;
 		rcan->can.state = CAN_STATE_ERROR_PASSIVE;
 		/* error passive state */
-		cf->can_id |= CAN_ERR_CRTL;
-		cf->data[1] = (txerr > rxerr) ?
-					CAN_ERR_CRTL_TX_WARNING :
-					CAN_ERR_CRTL_RX_WARNING;
-		cf->data[6] = txerr;
-		cf->data[7] = rxerr;
+		if (likely(skb)) {
+			cf->can_id |= CAN_ERR_CRTL;
+			cf->data[1] = (txerr > rxerr) ?
+				CAN_ERR_CRTL_TX_WARNING :
+				CAN_ERR_CRTL_RX_WARNING;
+			cf->data[6] = txerr;
+			cf->data[7] = rxerr;
+		}
+	} else if ((isr & BUS_ERR_INT) || (isr & RX_BUF_OV_INT)) {
+		/* Neither a state transition nor received data. Classify the
+		 * event so that listeners subscribed to error frames can see
+		 * it, but never account it as a received packet.
+		 */
+		classified = true;
+		if (likely(skb)) {
+			if (isr & BUS_ERR_INT)
+				cf->can_id |= CAN_ERR_BUSERROR;
+			else {
+				cf->can_id |= CAN_ERR_CRTL;
+				cf->data[1] = CAN_ERR_CRTL_RX_OVERFLOW;
+			}
+		}
 	}
 
 	if (rcan->can.state >= CAN_STATE_BUS_OFF ||
@@ -799,9 +817,18 @@
 		netif_start_queue(ndev);
 	}
 
-	stats->rx_packets++;
-	stats->rx_bytes += cf->can_dlc;
-	netif_rx(skb);
+	/* Bus error / FIFO overflow interrupts are error conditions, not
+	 * received frames - keep them out of rx_packets.
+	 */
+	if (classified) {
+		stats->rx_errors++;
+	} else if (likely(skb)) {
+		stats->rx_packets++;
+		stats->rx_bytes += cf->can_dlc;
+	}
+
+	if (likely(skb))
+		netif_rx(skb);
 
 	return 0;
 }
